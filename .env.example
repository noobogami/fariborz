APP_NAME="Research Agent"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# Only the essentials to BOOT live here (database, redis, queue/cache/session).
# Everything else — LLM driver/model, API keys, Ollama/browser endpoints, human
# name, safety limits — is configured AFTER startup on the dashboard's Settings
# page (⚙️ Settings) and stored in the database.
# ─────────────────────────────────────────────────────────────────────────────

# Queue (long-running research runs on this).
QUEUE_CONNECTION=redis
RESEARCH_QUEUE_NAME=research
# How long the queue waits before re-dispatching an in-progress job. MUST be
# larger than a single iteration (which can run sandbox builds) or long jobs fail
# with "attempted too many times". Keep > AdvanceResearchJob::$timeout (600).
QUEUE_RETRY_AFTER=660

# Cache/session. "redis" needs the redis service; use "database"/"file" for a
# redis-free host (cache/jobs/sessions migrations ship in database/migrations).
CACHE_STORE=redis
SESSION_DRIVER=file

# ── Database (mandatory) ──────────────────────────────────────────────────────
# DB_HOST/REDIS_HOST are for running NATIVELY. Under Docker Compose the app
# reaches them at "mysql" / "redis"; Compose reads the credentials below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=research_agent
DB_USERNAME=research
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root          # mysql container root account / healthcheck only

# ── Redis (mandatory) ─────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_PASSWORD=                 # empty = passwordless (typical local/Docker default)

# ── Docker Compose published host ports ───────────────────────────────────────
APP_PORT=8080
OLLAMA_PORT=11434
BROWSER_PORT=3001
SANDBOX_PORT=3002
# Pool of host ports the sandbox publishes for web apps the agent runs (viewable
# at http://localhost:<port>). The agent picks a free one via sandbox_info.
SANDBOX_APP_PORTS=8090-8099
SANDBOX_MEM=2g

# ─────────────────────────────────────────────────────────────────────────────
# The values below are OPTIONAL bootstrap defaults. You normally leave them and
# configure everything in the Settings UI instead; they only seed the first-run
# defaults (and are overridden by anything you set in the UI).
# ─────────────────────────────────────────────────────────────────────────────
# Default gateway model (a name from Tools ▸ Gateway models). Used when no tier
# overrides it. LEAVE IT BLANK unless you want to pin one: these names are aliases
# you create in the UI, so a literal here goes stale the moment you rename it —
# blank means "use whatever the gateway serves". EVERY model call goes through the
# LiteLLM gateway below — the app never talks to Ollama directly. (Ollama's URL is
# set on the litellm service in docker-compose; expose native Ollama with
# `launchctl setenv OLLAMA_HOST 0.0.0.0`.)
RESEARCH_LLM_MODEL=
BROWSER_SERVICE_URL=http://localhost:3001

# ── LLM gateway (LiteLLM) — the ONLY path to models (local Ollama + cloud) ─────
LLM_GATEWAY_URL=http://localhost:4000/v1
# The gateway's Bearer token. LITELLM_MASTER_KEY secures the gateway; LLM_GATEWAY_KEY
# is how the app authenticates to it — they MUST match. Change this dev default for
# anything beyond local use. (In Docker both derive from LITELLM_MASTER_KEY.)
LITELLM_MASTER_KEY=sk-fariborz-local
LLM_GATEWAY_KEY=sk-fariborz-local

# LiteLLM admin UI (http://localhost:4000/ui) — manage gateway models/keys/spend.
# CHANGE these for anything beyond local dev. Log in with UI user/pass or the
# master key. LITELLM_SALT_KEY encrypts provider keys saved via the UI into the DB.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=admin
LITELLM_DB_PASSWORD=litellm
LITELLM_SALT_KEY=sk-salt-fariborz-local

# Cloud provider keys — read by the LiteLLM service (NOT the app). Set the ones
# you want reachable when online; leave blank to stay fully local/offline. You can
# also add cloud models with their keys straight from Tools ▸ Gateway models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Per-task model routing (optional). The supervisor tags each task with a tier;
# the tier's model runs it. Blank = use RESEARCH_LLM_MODEL above. Prefer setting
# these in Settings ▸ Model tiers, where the dropdown only offers names the gateway
# really serves. Mix local + cloud, e.g.:
#   RESEARCH_LLM_TIER_LIGHT=local-fast
#   RESEARCH_LLM_TIER_STANDARD=local-standard
#   RESEARCH_LLM_TIER_HARD=claude
RESEARCH_LLM_TIER_LIGHT=
RESEARCH_LLM_TIER_STANDARD=
RESEARCH_LLM_TIER_HARD=
RESEARCH_LLM_DEFAULT_TIER=standard
